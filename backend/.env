# Database configuration
# Update the password to match your PostgreSQL installation
# Common default passwords: postgres, admin, or empty string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ctem_project
# Alternative for empty password: postgresql://postgres:@localhost:5432/ctem_project
# Alternative for different user: postgresql://your_user:your_password@localhost:5432/ctem_project

# OpenVAS configuration
OPENVAS_SOCKET=/var/run/gvmd.sock
OPENVAS_USERNAME=admin
OPENVAS_PASSWORD=your-password
OPENVAS_CONFIG_ID=daba56c8-73ec-11df-a475-002264764cea

# API configuration
API_HOST=0.0.0.0
API_PORT=3001
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Security
SECRET_KEY=your-secret-key-here

# Scanning tools paths (Windows)
NMAP_PATH=nmap
SEARCHSPLOIT_PATH=searchsploit
